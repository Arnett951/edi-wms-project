		sourceColumn: INVENTORY_VALUE

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	column 'Warehouse Age Bucket Sort' =
			
			SWITCH (
			    TRUE (),
			    InventoryAging[WAREHOUSE_AGE_DAYS] <= 30, 1,
			    InventoryAging[WAREHOUSE_AGE_DAYS] <= 60, 2,
			    InventoryAging[WAREHOUSE_AGE_DAYS] <= 90, 3,
			    InventoryAging[WAREHOUSE_AGE_DAYS] <= 180, 4,
			    5
			)
		formatString: 0
		lineageTag: 5c5450fc-e57f-47a2-ac06-a51331889552
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Warehouse Age Bucket' =
			
			SWITCH (
			    TRUE (),
			    InventoryAging[WAREHOUSE_AGE_DAYS] <= 30, "7-30 days",
			    InventoryAging[WAREHOUSE_AGE_DAYS] <= 60, "31-60 days",
			    InventoryAging[WAREHOUSE_AGE_DAYS] <= 90, "61-90 days",
			    InventoryAging[WAREHOUSE_AGE_DAYS] <= 180, "91-180 days",
			    "180+ days"
			)
		lineageTag: 5b3d8b3e-2a16-497f-a704-01768a17e063
		summarizeBy: none
		sortByColumn: 'Warehouse Age Bucket Sort'

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column 'Tire Age Years' =
			
			IF (
			    ISBLANK ( InventoryAging[TIRE_AGE_DAYS] ),
			    BLANK (),
			    ROUNDDOWN ( InventoryAging[TIRE_AGE_DAYS] / 365.25, 0 )
			)
		lineageTag: bc6be33b-1fa5-485d-9246-91b06afaca68
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column 'Tire Age Bucket Sort' =
			
			VAR y = InventoryAging[TIRE_AGE_DAYS] / 365.25
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( InventoryAging[TIRE_AGE_DAYS] ), 5,
			        y < 1, 1,
			        y < 3, 2,
			        y < 6, 3,
			        4
			    )
		formatString: 0
		lineageTag: 54bcefa4-358c-4e64-ada7-b897b02db0c9
		summarizeBy: sum

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column 'Tire Age Bucket' =
			
			VAR y = InventoryAging[TIRE_AGE_DAYS] / 365.25
			RETURN
			    SWITCH (
			        TRUE (),
			        ISBLANK ( InventoryAging[TIRE_AGE_DAYS] ), "No DOT data",
			        y < 1, "Under 1 yr",
			        y < 3, "1-3 yrs",
			        y < 6, "3-6 yrs",
			        "6+ yrs"
			    )
		lineageTag: 5e6cf306-411d-4e7d-9cea-89ace2ecac94
		summarizeBy: none
		sortByColumn: 'Tire Age Bucket Sort'

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

