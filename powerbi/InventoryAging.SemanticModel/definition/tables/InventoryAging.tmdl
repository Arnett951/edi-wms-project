table InventoryAging
	lineageTag: 9cb507dd-8954-4ac5-8b7a-9e2349d5af9e

	measure 'On Hand Qty' = SUM ( InventoryAging[ON_HAND_QTY] )
		formatString: 0
		lineageTag: f9fb3661-7974-4b67-8b15-6c8b49ad733d

	measure 'Reserved Qty' = SUM ( InventoryAging[RESERVED_QTY] )
		formatString: 0
		lineageTag: 5cf6584a-3deb-4751-86b3-dde9ea65345c

	measure 'Available Qty' = SUM ( InventoryAging[AVAILABLE_QTY] )
		formatString: 0
		lineageTag: 190d661f-768e-46e2-9eab-b7cd7996b5aa

	measure 'Inventory Value' = SUM ( InventoryAging[INVENTORY_VALUE] )
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: a8c6d0ca-7d46-48d0-9c58-231a6c312159

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Lot Count' = COUNTROWS ( InventoryAging )
		formatString: 0
		lineageTag: e756553d-44b9-4d50-9e19-658efada57bf

	measure 'SKU Count' = DISTINCTCOUNT ( InventoryAging[SKU] )
		formatString: 0
		lineageTag: d8617096-1ec9-4fdb-bbbd-bbbd01194526

	measure 'Avg Warehouse Age (Days)' =
			
			DIVIDE (
			    SUMX ( InventoryAging, InventoryAging[WAREHOUSE_AGE_DAYS] * InventoryAging[ON_HAND_QTY] ),
			    [On Hand Qty]
			)
		lineageTag: 7eb8c7c4-4d9c-4794-b00c-0c37572ce0b6

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Max Warehouse Age (Days)' = MAX ( InventoryAging[WAREHOUSE_AGE_DAYS] )
		formatString: 0
		lineageTag: 6795fcc5-1aa6-4277-8827-3d2b20cbde13

	measure 'Oldest Received Date' = MIN ( InventoryAging[RECEIVED_DATE] )
		formatString: General Date
		lineageTag: 5a5dd7e4-ee81-44e2-8590-ef925847935f

	measure 'Avg Tire Age (Years)' =
			
			DIVIDE (
			    SUMX (
			        FILTER ( InventoryAging, NOT ISBLANK ( InventoryAging[TIRE_AGE_DAYS] ) ),
			        InventoryAging[TIRE_AGE_DAYS] * InventoryAging[ON_HAND_QTY]
			    ),
			    CALCULATE ( [On Hand Qty], NOT ISBLANK ( InventoryAging[TIRE_AGE_DAYS] ) )
			) / 365.25
		lineageTag: 16fdb58f-ee99-4913-be76-719c14d272fe

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Value Aged 90+' =
			
			CALCULATE ( [Inventory Value], InventoryAging[WAREHOUSE_AGE_DAYS] > 90 )
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: 687c60e2-12df-44ab-86dc-933b3268c9b2

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure '% Value Aged 90+' = DIVIDE ( [Value Aged 90+], [Inventory Value] )
		lineageTag: 9f78ea95-dd08-4e82-9103-4c69f4933ae2

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Qty Aged 90+' =
			
			CALCULATE ( [On Hand Qty], InventoryAging[WAREHOUSE_AGE_DAYS] > 90 )
		formatString: 0
		lineageTag: 8b5dc8fb-59fb-4474-9ddf-4f4bded4bc73

	measure 'Qty DOT 6+ Yrs' =
			
			CALCULATE ( [On Hand Qty], InventoryAging[TIRE_AGE_DAYS] >= 6 * 365.25 )
		formatString: 0
		lineageTag: 87ff2825-45bf-4cdb-8205-78467e1c8416

	measure 'Value DOT 6+ Yrs' =
			
			CALCULATE ( [Inventory Value], InventoryAging[TIRE_AGE_DAYS] >= 6 * 365.25 )
		formatString: \$#,0.###############;(\$#,0.###############);\$#,0.###############
		lineageTag: e29747ad-4662-4657-ba80-f9eb7eb86fb1

		annotation PBI_FormatHint = {"currencyCulture":"en-US"}

	measure 'Qty Not Available' =
			
			CALCULATE ( [On Hand Qty], InventoryAging[STOCK_STATUS] <> "AVAILABLE" )
		formatString: 0
		lineageTag: 7104c44c-6d3e-4b17-855e-9655616de0e5

	measure '% of Total Value' =
			
			DIVIDE (
			    [Inventory Value],
			    CALCULATE ( [Inventory Value], REMOVEFILTERS ( InventoryAging[Warehouse Age Bucket], InventoryAging[Warehouse Age Bucket Sort] ) )
			)
		lineageTag: 52318728-70dd-40af-81fa-c55a57dc4433

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Data As Of' =
			
			"Data as of " & FORMAT ( MAX ( LoadInfo[LOADED_AT] ), "yyyy-mm-dd hh:nn" ) & " UTC"
		lineageTag: d597b9dd-2309-4848-abed-4d21b7b2f07a

	measure 'Report Title' =
			
			VAR f = SELECTEDVALUE ( InventoryAging[WAREHOUSE_CODE], "All facilities" )
			RETURN "Warehouse Inventory Aging - " & f
		lineageTag: b6f6e918-6c97-4c18-a7c3-3e449274e25e

